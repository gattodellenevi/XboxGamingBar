<Page
    x:Class="XboxGamingBar.GamingWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:XboxGamingBar"
    xmlns:converter="using:XboxGamingBar.Converter"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="670" d:DesignWidth="500"
    FocusVisualPrimaryBrush="{ThemeResource SystemControlFocusVisualPrimaryBrush}"
    FocusVisualSecondaryBrush="{ThemeResource SystemControlFocusVisualSecondaryBrush}"
    FocusVisualPrimaryThickness="2"
    FocusVisualSecondaryThickness="1"
    FocusVisualMargin="-2">

    <Page.Resources>
        <converter:MegahertzStringConverter x:Key="MegahertzStringConverter"/>
        <converter:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converter:SharpnessPercentStringConverter x:Key="SharpnessPercentStringConverter"/>
        <converter:RadeonBoostResolutionStringConverter x:Key="RadeonBoostResolutionStringConverter"/>
        <converter:RadeonChillMinFPSStringConverter x:Key="RadeonChillMinFPSStringConverter"/>
        <converter:RadeonChillMaxFPSStringConverter x:Key="RadeonChillMaxFPSStringConverter"/>
        <converter:FPSStringConverter x:Key="FPSStringConverter"/>
        <converter:OSDTextSizeStringConverter x:Key="OSDTextSizeStringConverter"/>

        <!-- High-Visibility Xbox Green Focus Brushes -->
        <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#107C41"/>
        <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#FFFFFF"/>

        <!-- Brand Accent Colors -->
        <SolidColorBrush x:Key="RadeonRubyBrush" Color="#ED1C24"/>
        <SolidColorBrush x:Key="GeForceGreenBrush" Color="#76B900"/>
        <SolidColorBrush x:Key="XboxGreenBrush" Color="#107C41"/>

        <!-- Reusable Card Container Style -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12,14,12"/>
            <Setter Property="Margin" Value="10,0,10,10"/>
        </Style>

        <!-- Reusable Value Badge Container Style -->
        <Style x:Key="ValueBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="6,1,6,1"/>
            <Setter Property="Background" Value="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Reusable Value Badge Text Style -->
        <Style x:Key="ValueBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Segmented Quick-Toggle Button Style -->
        <Style x:Key="SegmentedButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="2,0,2,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Reusable Subtitle Text Style -->
        <Style x:Key="SubtitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Reusable Section Header Text Style -->
        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
            <Setter Property="Margin" Value="14,8,14,6"/>
            <Setter Property="CharacterSpacing" Value="50"/>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Option 4: Fluent 2 Modal Loading Card (Input Guard) -->
        <Grid x:Name="LoadingModalOverlay" Grid.RowSpan="2" Canvas.ZIndex="100" 
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Visibility="Collapsed">
            <Border Width="320" CornerRadius="12" Padding="24,28,24,24" 
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Icon in Pill Badge -->
                    <Border Width="48" Height="48" CornerRadius="10" 
                            Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" 
                            HorizontalAlignment="Center" Margin="0,0,0,16">
                        <FontIcon Glyph="&#xE7FC;" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                  Foreground="{StaticResource XboxGreenBrush}"/>
                    </Border>
                    
                    <!-- Progress Ring -->
                    <ProgressRing x:Name="LoadingModalProgressRing" Width="36" Height="36" IsActive="True" 
                                  Foreground="{StaticResource XboxGreenBrush}" 
                                  HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    
                    <!-- Title -->
                    <TextBlock x:Name="LoadingModalTitleText" Text="Connecting to Helper..." 
                               FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" 
                               Margin="0,0,0,6" TextAlignment="Center"/>
                    
                    <!-- Subtitle -->
                    <TextBlock x:Name="LoadingModalSubtitleText" Text="Initializing hardware sensors &amp; power controls..." 
                               FontSize="12" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Shortcut Editor Modal Dialog -->
        <Grid x:Name="ShortcutEditorOverlay" Grid.RowSpan="2" Canvas.ZIndex="99" 
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Visibility="Collapsed">
            <Border Width="380" MaxHeight="580" CornerRadius="12" Padding="18,16,18,16" 
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" XYFocusKeyboardNavigation="Enabled">
                    <StackPanel>
                        <!-- Header -->
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="6" 
                                        Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" 
                                        Margin="0,0,10,0" VerticalAlignment="Center">
                                    <FontIcon x:Name="EditorHeaderIcon" Glyph="&#xE765;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                              Foreground="{StaticResource XboxGreenBrush}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="EditorModalTitleText" Text="Add Shortcut" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Configure hotkey and button action" Style="{StaticResource SubtitleTextStyle}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="EditorCloseTopButton" HorizontalAlignment="Right" VerticalAlignment="Top" 
                                    Width="30" Height="30" Padding="0" Background="Transparent" BorderThickness="0"
                                    Click="EditorCancelButton_Click">
                                <FontIcon Glyph="&#xE711;" FontSize="12"/>
                            </Button>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,0,0,10"/>

                        <!-- Preset Selector -->
                        <TextBlock Text="QUICK PRESET" Style="{StaticResource SectionHeaderTextStyle}" Margin="2,0,2,4"/>
                        <ComboBox x:Name="EditorPresetComboBox" HorizontalAlignment="Stretch" Margin="0,0,0,10"
                                  SelectionChanged="EditorPresetComboBox_SelectionChanged"/>

                        <!-- Name & Icon -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="NAME" Style="{StaticResource SectionHeaderTextStyle}" Margin="2,0,2,4"/>
                                <TextBox x:Name="EditorNameTextBox" PlaceholderText="e.g. Screenshot" TextChanged="EditorInput_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="ICON" Style="{StaticResource SectionHeaderTextStyle}" Margin="2,0,2,4"/>
                                <ComboBox x:Name="EditorIconComboBox" HorizontalAlignment="Stretch"
                                          SelectionChanged="EditorInput_Changed">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Glyph="{Binding Glyph}" FontSize="13" Margin="0,0,8,0" Foreground="{StaticResource XboxGreenBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Key Combination Section -->
                        <TextBlock Text="KEY COMBINATION" Style="{StaticResource SectionHeaderTextStyle}" Margin="2,2,2,4"/>
                        
                        <!-- Modifiers Toggle Row -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="EditorCtrlToggle" Grid.Column="0" Content="Ctrl" Margin="2,0,2,0" HorizontalAlignment="Stretch" Click="EditorModifier_Click"/>
                            <ToggleButton x:Name="EditorAltToggle" Grid.Column="1" Content="Alt" Margin="2,0,2,0" HorizontalAlignment="Stretch" Click="EditorModifier_Click"/>
                            <ToggleButton x:Name="EditorShiftToggle" Grid.Column="2" Content="Shift" Margin="2,0,2,0" HorizontalAlignment="Stretch" Click="EditorModifier_Click"/>
                            <ToggleButton x:Name="EditorWinToggle" Grid.Column="3" Content="Win" Margin="2,0,2,0" HorizontalAlignment="Stretch" Click="EditorModifier_Click"/>
                        </Grid>

                        <!-- Primary Key Dropdown -->
                        <ComboBox x:Name="EditorKeyComboBox" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                  SelectionChanged="EditorKeyComboBox_SelectionChanged"/>

                        <!-- Record Keys Button -->
                        <Button x:Name="EditorRecordKeysButton" HorizontalAlignment="Stretch" Margin="0,0,0,10"
                                Height="34" CornerRadius="6"
                                Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                Click="EditorRecordKeysButton_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <FontIcon x:Name="EditorRecordIcon" Glyph="&#xEDA7;" FontSize="13" Margin="0,0,6,0" Foreground="{StaticResource XboxGreenBrush}"/>
                                <TextBlock x:Name="EditorRecordText" Text="Press Keys to Record" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Preview Card -->
                        <Border Style="{StaticResource ValueBadgeStyle}" HorizontalAlignment="Stretch" Padding="10,8,10,8" Margin="0,0,0,14"
                                Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="EditorPreviewIcon" Grid.Column="0" Glyph="&#xE765;" FontSize="16" Foreground="{StaticResource XboxGreenBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="EditorPreviewName" Grid.Column="1" Text="Shortcut Name" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Column="2" Style="{StaticResource ValueBadgeStyle}" Padding="6,2,6,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="EditorPreviewComboText" Text="None" Style="{StaticResource ValueBadgeTextStyle}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Action Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="EditorTestButton" Grid.Column="0" Content="Test" 
                                    CornerRadius="6" Padding="12,6,12,6"
                                    Click="EditorTestButton_Click"/>
                            <Button x:Name="EditorCancelButton" Grid.Column="2" Content="Cancel" 
                                    Margin="0,0,8,0" CornerRadius="6" Padding="14,6,14,6"
                                    Click="EditorCancelButton_Click"/>
                            <Button x:Name="EditorSaveButton" Grid.Column="3" Content="Save" 
                                    Background="{StaticResource XboxGreenBrush}" Foreground="White" FontWeight="Bold"
                                    CornerRadius="6" Padding="16,6,16,6"
                                    Click="EditorSaveButton_Click"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Running Game Info (Hero Card) -->
        <Border Grid.Row="0" Margin="10,10,10,6" CornerRadius="10" 
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" Padding="12,10,12,10">
            <Grid x:Name="GameInfoGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Gamepad Icon Badge -->
                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" 
                        Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" 
                        Margin="0,0,12,0" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE7FC;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" 
                              Foreground="{StaticResource XboxGreenBrush}"/>
                </Border>

                <!-- Game Name & Subtitle with Status Dot -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource XboxGreenBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RunningGameText" Text="No game detected" FontWeight="SemiBold" FontSize="16"
                            TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                    <TextBlock Text="Active profile configuration" FontSize="11" 
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>

                <!-- Helper Elevation Warning Button (Shown when not elevated or offline) -->
                <Button x:Name="HeroElevationWarningButton" Grid.Column="2" 
                        Margin="0,0,8,0" Padding="8,3,8,3"
                        Height="28" CornerRadius="6"
                        Background="#2D2305" BorderBrush="#CA8A04" BorderThickness="1"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        ToolTipService.ToolTip="Helper running without Administrator privileges. Hardware power controls are limited."
                        Click="HeroElevationWarningButton_Click">
                    <Button.Flyout>
                        <Flyout x:Name="HelperElevationFlyout" Placement="Bottom" LightDismissOverlayMode="On">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="MaxWidth" Value="320"/>
                                    <Setter Property="Padding" Value="14,14,14,14"/>
                                    <Setter Property="CornerRadius" Value="8"/>
                                    <Setter Property="Background" Value="#252525"/>
                                    <Setter Property="BorderBrush" Value="#484848"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                                    <Setter Property="IsTabStop" Value="False"/>
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <StackPanel x:Name="HelperElevationFlyoutContent" Width="280" XYFocusKeyboardNavigation="Enabled">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <FontIcon Glyph="&#xE897;" FontSize="16" Margin="0,0,8,0" Foreground="{StaticResource XboxGreenBrush}"/>
                                    <TextBlock Text="Helper Elevation" FontWeight="SemiBold" FontSize="15" Foreground="White"/>
                                </StackPanel>
                                <TextBlock Text="Running the helper with administrator privileges allows CouchGamingBar to fully control RTSS and system settings. Frame limiting may not work without administrator privileges."
                                           Style="{StaticResource SubtitleTextStyle}"
                                           Foreground="#D0D0D0"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,14"/>
                                <Button x:Name="RestartElevatedButton"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,10"
                                        Padding="10,6,10,6"
                                        CornerRadius="6"
                                        Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        IsTabStop="True"
                                        XYFocusDown="{Binding ElementName=CloseElevationHelpButton}"
                                        Click="RestartElevatedButton_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE7EF;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource XboxGreenBrush}"/>
                                        <TextBlock x:Name="RestartElevatedButtonText" Text="Restart as Administrator" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CloseElevationHelpButton"
                                        Content="Close"
                                        HorizontalAlignment="Stretch"
                                        Padding="0,6,0,6"
                                        CornerRadius="6"
                                        IsTabStop="True"
                                        XYFocusUp="{Binding ElementName=RestartElevatedButton}"
                                        Click="CloseElevationHelpButton_Click"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <FontIcon x:Name="HeroElevationWarningIcon" Glyph="&#xE7BA;" FontSize="12" Foreground="#F59E0B" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="HeroElevationWarningText" Text="Admin Needed" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Profile Switch -->
                <ToggleSwitch x:Name="PerGameProfileToggle" Grid.Column="3" IsEnabled="False" 
                              OffContent="Global" OnContent="Per-game"
                              VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">

            <!-- Tab Navigation Indicators (Modern Pill Bumpers with Xbox Theme) -->
            <Border Width="28" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,10,0,0" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1.2" CornerRadius="6" 
                    Background="{ThemeResource LayerFillColorDefaultBrush}" IsHitTestVisible="False" Canvas.ZIndex="2">
                <TextBlock Text="LT" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" 
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" CharacterSpacing="30"/>
            </Border>
            <Border Width="28" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,8,0" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1.2" CornerRadius="6" 
                    Background="{ThemeResource LayerFillColorDefaultBrush}" IsHitTestVisible="False" Canvas.ZIndex="2">
                <TextBlock Text="RT" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" 
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" CharacterSpacing="30"/>
            </Border>
            
            <Pivot x:Name="MainPivot" IsHeaderItemsCarouselEnabled="False" XYFocusKeyboardNavigation="Enabled" UseSystemFocusVisuals="True">
                <!-- PERFORMANCE TAB -->
                <PivotItem>
                    <PivotItem.Header>
                        <StackPanel Orientation="Horizontal" Margin="24,0,6,0">
                            <FontIcon Glyph="&#xE9D2;" Margin="0,0,8,0" FontSize="15" VerticalAlignment="Center" Foreground="{StaticResource XboxGreenBrush}"/>
                            <TextBlock Text="Performance" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </PivotItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" XYFocusKeyboardNavigation="Enabled">
                        <StackPanel Margin="0,8,0,16">

                            <!-- SECTION: OVERLAY -->
                            <TextBlock Text="OVERLAY" Style="{StaticResource SectionHeaderTextStyle}"/>
                            
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock x:Name="PerformanceOverlayText" Text="Performance Overlay" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock Text="RTSS / ADLX in-game metrics overlay" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Segmented Quick Selector Bar -->
                                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,2,0,4">
                                        <Grid x:Name="OSDSegmentedGrid">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Button x:Name="OSDLevel0Button" Grid.Column="0" Content="OFF" Tag="0" 
                                                    Style="{StaticResource SegmentedButtonStyle}" Click="OSDLevelButton_Click"
                                                    IsEnabled="{Binding ElementName=PerformanceOverlaySlider, Path=IsEnabled}"
                                                    XYFocusRight="{Binding ElementName=OSDLevel1Button}"/>

                                            <Button x:Name="OSDLevel1Button" Grid.Column="1" Content="FPS" Tag="1" 
                                                    Style="{StaticResource SegmentedButtonStyle}" Click="OSDLevelButton_Click"
                                                    IsEnabled="{Binding ElementName=PerformanceOverlaySlider, Path=IsEnabled}"
                                                    XYFocusLeft="{Binding ElementName=OSDLevel0Button}"
                                                    XYFocusRight="{Binding ElementName=OSDLevel2Button}"/>

                                            <Button x:Name="OSDLevel2Button" Grid.Column="2" Content="DETAIL" Tag="2" 
                                                    Style="{StaticResource SegmentedButtonStyle}" Click="OSDLevelButton_Click"
                                                    IsEnabled="{Binding ElementName=PerformanceOverlaySlider, Path=IsEnabled}"
                                                    XYFocusLeft="{Binding ElementName=OSDLevel1Button}"
                                                    XYFocusRight="{Binding ElementName=OSDLevel3Button}"/>

                                            <Button x:Name="OSDLevel3Button" Grid.Column="3" Content="FULL" Tag="3" 
                                                    Style="{StaticResource SegmentedButtonStyle}" Click="OSDLevelButton_Click"
                                                    IsEnabled="{Binding ElementName=PerformanceOverlaySlider, Path=IsEnabled}"
                                                    XYFocusLeft="{Binding ElementName=OSDLevel2Button}"
                                                    XYFocusRight="{Binding ElementName=OSDLevel4Button}"/>

                                            <Button x:Name="OSDLevel4Button" Grid.Column="4" Content="ALL" Tag="4" 
                                                    Style="{StaticResource SegmentedButtonStyle}" Click="OSDLevelButton_Click"
                                                    IsEnabled="{Binding ElementName=PerformanceOverlaySlider, Path=IsEnabled}"
                                                    XYFocusLeft="{Binding ElementName=OSDLevel3Button}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Underlying Slider (Preserved for OSDProperty compatibility) -->
                                    <Slider x:Name="PerformanceOverlaySlider"
                                        Minimum="0" Maximum="4"
                                        TickFrequency="1"
                                        SnapsTo="StepValues"
                                        TickPlacement="None"
                                        IsEnabled="False"
                                        Height="0"
                                        Opacity="0"
                                        Margin="0"
                                        IsHitTestVisible="False"/>

                                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,10,0,10"/>

                                    <Grid Margin="0,2,0,2">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="OverlayTextSizeText" Text="Text Size" FontWeight="SemiBold" FontSize="15"
                                                    TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <Border Style="{StaticResource ValueBadgeStyle}" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding ElementName=OverlayTextSizeSlider, Path=Value, Converter={StaticResource OSDTextSizeStringConverter}}" 
                                                               Style="{StaticResource ValueBadgeTextStyle}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Scale overlay typography (relative to resolution)" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Slider x:Name="OverlayTextSizeSlider"
                                        Minimum="50" Maximum="200"
                                        StepFrequency="10"
                                        TickFrequency="10"
                                        SnapsTo="StepValues"
                                        TickPlacement="None"
                                        Margin="0,2,0,2"
                                        IsEnabled="False"/>
                                </StackPanel>
                            </Border>

                            <!-- SECTION: FRAME PACING -->
                            <TextBlock Text="FRAME PACING" Style="{StaticResource SectionHeaderTextStyle}"/>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <!-- Frame Limiter Toggle Row with Header Value Badge -->
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="FPSLimitText" Text="Frame Limiter" FontWeight="SemiBold" FontSize="15"
                                                    TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <Border Style="{StaticResource ValueBadgeStyle}" Margin="8,0,0,0"
                                                        Visibility="{Binding ElementName=LimitFPSToggle, Path=IsOn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding ElementName=FPSLimitSlider, Path=Value, Converter={StaticResource FPSStringConverter}}" 
                                                               Style="{StaticResource ValueBadgeTextStyle}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Cap framerate via RTSS to stabilize frametimes" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="LimitFPSToggle" IsEnabled="False" 
                                            OffContent="Disabled" OnContent="Enabled"
                                            VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Expanded Frame Limiter Settings -->
                                    <StackPanel Visibility="{Binding ElementName=LimitFPSToggle, Path=IsOn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,10,0,10"/>

                                        <Slider x:Name="FPSLimitSlider"
                                            Minimum="30" Maximum="300"
                                            TickFrequency="1"
                                            SnapsTo="Ticks"
                                            TickPlacement="BottomRight"
                                            IsEnabled="False"/>

                                        <Slider x:Name="FPSLimitJudderFreeSlider"
                                            Minimum="0" Maximum="1"
                                            StepFrequency="1"
                                            TickFrequency="1"
                                            SnapsTo="StepValues"
                                            TickPlacement="None"
                                            IsEnabled="{Binding ElementName=FPSLimitSlider, Path=IsEnabled}"
                                            Visibility="Collapsed"/>

                                        <Canvas x:Name="FPSLimitJudderFreeCanvas" Height="24" Margin="10,-6,10,4"/>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,4,0,10"/>

                                        <!-- Judder Free Toggle -->
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock x:Name="JudderFreeFPSText" Text="Judder Free FPS" FontWeight="Normal" FontSize="14"/>
                                                <TextBlock Text="Snap slider to refresh rate divisors" Style="{StaticResource SubtitleTextStyle}"/>
                                            </StackPanel>
                                            <ToggleSwitch x:Name="JudderFreeFPSToggle" OffContent="All" OnContent="Judder Free"
                                                VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <!-- Limiter Mode ComboBox -->
                                        <Grid Margin="0,4,0,2">
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock x:Name="FPSLimitModeText" Text="Limiter Mode" FontWeight="Normal" FontSize="14"/>
                                                <TextBlock Text="RTSS frame synchronization method" Style="{StaticResource SubtitleTextStyle}"/>
                                            </StackPanel>
                                            <ComboBox x:Name="FPSLimitModeComboBox" SelectedIndex="0" HorizontalAlignment="Right" VerticalAlignment="Center" Width="140" IsEnabled="False">
                                                <ComboBoxItem Content="Async"/>
                                                <ComboBoxItem Content="Front Edge Sync"/>
                                                <ComboBoxItem Content="Back Edge Sync"/>
                                                <ComboBoxItem Content="NVIDIA Reflex"/>
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- SECTION: CPU POWER & CLOCKS -->
                            <TextBlock Text="CPU POWER &amp; CLOCKS" Style="{StaticResource SectionHeaderTextStyle}"/>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <!-- CPU Boost with Value Badge -->
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="CPUBoostText" Text="CPU Boost" FontWeight="SemiBold" FontSize="15"
                                                    TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <Border Style="{StaticResource ValueBadgeStyle}" Margin="8,0,0,0"
                                                        Visibility="{Binding ElementName=CPUBoostToggle, Path=IsOn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="AGGRESSIVE" Style="{StaticResource ValueBadgeTextStyle}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Dynamic core clock frequency boosting" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="CPUBoostToggle" IsEnabled="False" OffContent="Disabled" OnContent="Enabled"
                                            VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,10,0,10"/>

                                    <!-- Energy Pref (EPP) with Value Badge -->
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="CPUEPPText" Text="Energy Preference (EPP)" FontWeight="SemiBold" FontSize="15"
                                                    TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <Border Style="{StaticResource ValueBadgeStyle}" Margin="8,0,0,0"
                                                        Visibility="{Binding ElementName=SetCPUEPPToggle, Path=IsOn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding ElementName=CPUEPPSlider, Path=Value}" Style="{StaticResource ValueBadgeTextStyle}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Balance performance vs power efficiency" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="SetCPUEPPToggle" IsEnabled="False" OffContent="Disabled" OnContent="Enabled"
                                            VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Slider x:Name="CPUEPPSlider"
                                        Minimum="10" Maximum="95"
                                        TickFrequency="5"
                                        SnapsTo="Ticks"
                                        TickPlacement="BottomRight"
                                        IsEnabled="False"
                                        Margin="0,6,0,0"
                                        Visibility="{Binding ElementName=SetCPUEPPToggle, Path=IsOn, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,10,0,10"/>

                                    <!-- Limit CPU Clock with Value Badge -->
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="LimitCPUClockText" Text="Limit CPU Clock" FontWeight="SemiBold" FontSize="15"
                                                    TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <Border Style="{StaticResource ValueBadgeStyle}" Margin="8,0,0,0"
                                                        Visibility="{Binding ElementName=LimitCPUClockToggle, Path=IsOn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding ElementName=CPUClockMaxSlider, Path=Value, Converter={StaticResource MegahertzStringConverter}}" Style="{StaticResource ValueBadgeTextStyle}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Cap maximum CPU frequency in MHz" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="LimitCPUClockToggle" IsEnabled="False" OffContent="Disabled" OnContent="Enabled"
                                            VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Slider x:Name="CPUClockMaxSlider"
                                        Minimum="300" Maximum="5100"
                                        TickFrequency="100"
                                        SnapsTo="Ticks"
                                        TickPlacement="BottomRight"
                                        IsEnabled="False"
                                        Margin="0,6,0,0"
                                        Visibility="{Binding ElementName=LimitCPUClockToggle, Path=IsOn, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>

                <!-- SHORTCUTS TAB -->
                <PivotItem x:Name="ShortcutsPivotItem">
                    <PivotItem.Header>
                        <StackPanel Orientation="Horizontal" Margin="6,0,6,0">
                            <FontIcon Glyph="&#xE765;" Margin="0,0,8,0" FontSize="15" VerticalAlignment="Center" Foreground="{StaticResource XboxGreenBrush}"/>
                            <TextBlock Text="Shortcuts" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </PivotItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" XYFocusKeyboardNavigation="Enabled">
                        <StackPanel Margin="0,8,0,16">

                            <!-- SECTION: SHORTCUT BUTTONS -->
                            <TextBlock Text="SHORTCUTS" Style="{StaticResource SectionHeaderTextStyle}"/>

                            <Border Style="{StaticResource SettingsCardStyle}" Padding="10,10,10,10">
                                <StackPanel>
                                    <!-- Empty state placeholder -->
                                    <StackPanel x:Name="NoShortcutsPlaceholder" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,16,0,16">
                                        <FontIcon Glyph="&#xE765;" FontSize="28" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="No shortcuts configured" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Click 'Add New Shortcut' below to create one" Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Grid of square shortcut buttons (4 per row) -->
                                    <GridView x:Name="ShortcutsGridView" 
                                              SelectionMode="None" 
                                              IsItemClickEnabled="True"
                                              XYFocusKeyboardNavigation="Enabled"
                                              HorizontalAlignment="Center">
                                        <GridView.ItemContainerStyle>
                                            <Style TargetType="GridViewItem">
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                <Setter Property="MinWidth" Value="0"/>
                                                <Setter Property="MinHeight" Value="0"/>
                                            </Style>
                                        </GridView.ItemContainerStyle>
                                        <GridView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="-1" ItemWidth="105" ItemHeight="105"/>
                                            </ItemsPanelTemplate>
                                        </GridView.ItemsPanel>
                                        <GridView.ItemTemplate>
                                            <DataTemplate>
                                                <Button Click="ShortcutButton_Click"
                                                        RightTapped="ShortcutButton_RightTapped"
                                                        Holding="ShortcutButton_Holding"
                                                        Tag="{Binding}"
                                                        Width="98" Height="98"
                                                        Margin="2,2,2,2"
                                                        Padding="4,6,4,6"
                                                        CornerRadius="8"
                                                        Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <Button.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="Execute" Click="MenuExecute_Click" Tag="{Binding}">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE768;"/>
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Edit" Click="MenuEdit_Click" Tag="{Binding}">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE70F;"/>
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Delete" Click="MenuDelete_Click" Tag="{Binding}">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE74D;"/>
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                        </MenuFlyout>
                                                    </Button.ContextFlyout>
                                                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <!-- Icon -->
                                                        <FontIcon Grid.Row="0" Glyph="{Binding IconGlyph}" FontSize="22" Foreground="{StaticResource XboxGreenBrush}" HorizontalAlignment="Center" Margin="0,2,0,2"/>
                                                        <!-- Name -->
                                                        <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"/>
                                                        <!-- Hotkey Badge -->
                                                        <Border Grid.Row="2" Style="{StaticResource ValueBadgeStyle}" HorizontalAlignment="Center" Padding="5,1,5,1" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding DisplayKeyCombo}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>
                                </StackPanel>
                            </Border>

                            <!-- SECTION: ADD SHORTCUT BUTTON -->
                            <Border Style="{StaticResource SettingsCardStyle}" Margin="10,0,10,10" Padding="0">
                                <Button x:Name="AddShortcutButton" 
                                        HorizontalAlignment="Stretch" 
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent" 
                                        BorderThickness="0"
                                        Padding="14,12,14,12"
                                        Click="AddShortcutButton_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" 
                                                Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" 
                                                Margin="0,0,12,0" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE710;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                      Foreground="{StaticResource XboxGreenBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Add New Shortcut" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="Create custom key combinations and game hotkeys" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>

                <!-- SYSTEM TAB -->
                <PivotItem>
                    <PivotItem.Header>
                        <StackPanel Orientation="Horizontal" Margin="6,0,6,0">
                            <FontIcon Glyph="&#xE770;" Margin="0,0,8,0" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Text="System" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </PivotItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" XYFocusKeyboardNavigation="Enabled">
                        <StackPanel Margin="0,8,0,16">

                            <!-- SECTION: DISPLAY -->
                            <TextBlock Text="DISPLAY" Style="{StaticResource SectionHeaderTextStyle}"/>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,2,0,2">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock x:Name="RefreshRatesText" Text="Refresh Rate" FontWeight="SemiBold" FontSize="15"
                                                TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            <TextBlock Text="Active display refresh rate (Hz)" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="RefreshRatesComboBox" PlaceholderText="60 Hz" Width="140" IsEnabled="False" HorizontalAlignment="Right">
                                            <x:String>60 Hz</x:String>
                                        </ComboBox>
                                    </Grid>

                                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,10,0,10"/>

                                    <Grid Margin="0,2,0,2">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock x:Name="ResolutionsText" Text="Resolution" FontWeight="SemiBold" FontSize="15"
                                                TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            <TextBlock Text="Active screen display resolution" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="ResolutionsComboBox" PlaceholderText="1920x1080" Width="140" IsEnabled="False" HorizontalAlignment="Right">
                                            <x:String>1920x1080</x:String>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECTION: BACKGROUND SERVICES -->
                            <TextBlock Text="BACKGROUND SERVICES" Style="{StaticResource SectionHeaderTextStyle}"/>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <!-- Helper Process Row -->
                                    <Grid Margin="0,2,0,2">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="HelperStatusTitleText" Text="Helper Process" FontWeight="SemiBold" FontSize="15"
                                                    TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <Border x:Name="HelperElevationBadge" Style="{StaticResource ValueBadgeStyle}" Margin="8,0,0,0"
                                                        Background="#5A5A5A" BorderBrush="#5A5A5A">
                                                    <TextBlock x:Name="HelperElevationBadgeText" Text="OFFLINE" 
                                                               Style="{StaticResource ValueBadgeTextStyle}" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="HelperStatusSubtitleText" Text="Helper process is not running or disconnected" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Divider between Helper and RTSS -->
                                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,10,0,10"/>

                                    <!-- RTSS Process Row -->
                                    <Grid Margin="0,2,0,2">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="RTSSStatusTitleText" Text="RTSS Process" FontWeight="SemiBold" FontSize="15"
                                                    TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <Border x:Name="RTSSElevationBadge" Style="{StaticResource ValueBadgeStyle}" Margin="8,0,0,0"
                                                        Background="#5A5A5A" BorderBrush="#5A5A5A">
                                                    <TextBlock x:Name="RTSSElevationBadgeText" Text="OFFLINE" 
                                                               Style="{StaticResource ValueBadgeTextStyle}" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="RTSSStatusSubtitleText" Text="RivaTuner Statistics Server is not running" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Divider between RTSS and Hardware Monitor -->
                                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,10,0,10"/>

                                    <!-- Hardware Monitor Row -->
                                    <Grid Margin="0,2,0,2">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="HardwareProviderTitleText" Text="Hardware Monitor" FontWeight="SemiBold" FontSize="15"
                                                    TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <Border x:Name="HardwareProviderBadge" Style="{StaticResource ValueBadgeStyle}" Margin="8,0,0,0"
                                                        Background="#5A5A5A" BorderBrush="#5A5A5A">
                                                    <TextBlock x:Name="HardwareProviderBadgeText" Text="OFFLINE" 
                                                               Style="{StaticResource ValueBadgeTextStyle}" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="HardwareProviderSubtitleText" Text="Helper process is not running or disconnected" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- APPLICATION VERSION FOOTER -->
                            <StackPanel HorizontalAlignment="Center" Margin="0,24,0,8" Opacity="0.65">
                                <TextBlock x:Name="AppVersionText" Text="CouchGamingBar" FontSize="11" 
                                           HorizontalAlignment="Center"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>

                <!-- AMD SETTINGS TAB (Radeon Ruby Themed) -->
                <PivotItem x:Name="AMDPivotItem" Visibility="Collapsed">
                    <PivotItem.Header>
                        <StackPanel x:Name="AMDPivotItemStackPanel" Orientation="Horizontal" Margin="6,0,6,0" Visibility="Collapsed">
                            <FontIcon Glyph="&#xE945;" Margin="0,0,8,0" FontSize="15" VerticalAlignment="Center" Foreground="{StaticResource RadeonRubyBrush}"/>
                            <TextBlock Text="AMD" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </PivotItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" XYFocusKeyboardNavigation="Enabled">
                        <StackPanel Margin="0,8,0,16">

                            <!-- SECTION: UPSCALING & FRAME GEN -->
                            <TextBlock Text="RADEON UPSCALING &amp; FRAMES" Style="{StaticResource SectionHeaderTextStyle}"/>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Border.Resources>
                                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#ED1C24"/>
                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#D01820"/>
                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#B8141C"/>
                                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#ED1C24"/>
                                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#D01820"/>
                                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#B8141C"/>
                                </Border.Resources>
                                <StackPanel>
                                    <!-- RSR with Value Badge -->
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="AMDRadeonSuperResolutionText" Text="Radeon Super Resolution" FontWeight="SemiBold" FontSize="15"
                                                    TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                <Border Style="{StaticResource ValueBadgeStyle}" Margin="8,0,0,0"
                                                        Visibility="{Binding ElementName=AMDRadeonSuperResolutionToggle, Path=IsOn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding ElementName=AMDRadeonSuperResolutionSharpnessSlider, Path=Value, Converter={StaticResource SharpnessPercentStringConverter}}" Style="{StaticResource ValueBadgeTextStyle}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Spatial upscaling with sharpening filter" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="AMDRadeonSuperResolutionToggle" IsEnabled="False" OffContent="Disabled" OnContent="Enabled"
                                            VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="AMDRadeonSuperResolutionSharpnessSlider"
                                        Minimum="0" Maximum="100"
                                        TickFrequency="1"
                                        SnapsTo="Ticks"
                                        TickPlacement="BottomRight"
                                        IsEnabled="False"
                                        Margin="0,6,0,0"
                                        Visibility="{Binding ElementName=AMDRadeonSuperResolutionToggle, Path=IsOn, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,10,0,10"/>

                                    <!-- AFMF with Value Badge -->
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="AMDFluidMotionFrameText" Text="AMD Fluid Motion Frame" FontWeight="SemiBold" FontSize="15"
                                                    TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <Border Style="{StaticResource ValueBadgeStyle}" Margin="8,0,0,0"
                                                        Visibility="{Binding ElementName=AMDFluidMotionFrameToggle, Path=IsOn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="ON" Style="{StaticResource ValueBadgeTextStyle}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Optical flow driver-level frame generation" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="AMDFluidMotionFrameToggle" IsEnabled="False" OffContent="Disabled" OnContent="Enabled"
                                            VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECTION: LATENCY & DYNAMICS -->
                            <TextBlock Text="LATENCY &amp; DYNAMICS" Style="{StaticResource SectionHeaderTextStyle}"/>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Border.Resources>
                                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#ED1C24"/>
                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#D01820"/>
                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#B8141C"/>
                                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#ED1C24"/>
                                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#D01820"/>
                                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#B8141C"/>
                                </Border.Resources>
                                <StackPanel>
                                    <!-- Anti-Lag with Value Badge -->
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="AMDRadeonAntiLagText" Text="Radeon Anti-Lag" FontWeight="SemiBold" FontSize="15"
                                                    TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <Border Style="{StaticResource ValueBadgeStyle}" Margin="8,0,0,0"
                                                        Visibility="{Binding ElementName=AMDRadeonAntiLagToggle, Path=IsOn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="ON" Style="{StaticResource ValueBadgeTextStyle}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Paces CPU work to minimize input latency" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="AMDRadeonAntiLagToggle" IsEnabled="False" OffContent="Disabled" OnContent="Enabled"
                                            VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,10,0,10"/>

                                    <!-- Boost with Value Badge -->
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="AMDRadeonBoostText" Text="Radeon Boost" FontWeight="SemiBold" FontSize="15"
                                                    TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <Border Style="{StaticResource ValueBadgeStyle}" Margin="8,0,0,0"
                                                        Visibility="{Binding ElementName=AMDRadeonBoostToggle, Path=IsOn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding ElementName=AMDRadeonBoostResolutionSlider, Path=Value, Converter={StaticResource RadeonBoostResolutionStringConverter}}" Style="{StaticResource ValueBadgeTextStyle}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Dynamic resolution during fast camera motion" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="AMDRadeonBoostToggle" IsEnabled="False" OffContent="Disabled" OnContent="Enabled"
                                            VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="AMDRadeonBoostResolutionSlider"
                                        Minimum="0" Maximum="1"
                                        TickFrequency="1"
                                        SnapsTo="Ticks"
                                        TickPlacement="BottomRight"
                                        IsEnabled="False"
                                        Margin="0,6,0,0"
                                        Visibility="{Binding ElementName=AMDRadeonBoostToggle, Path=IsOn, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>

                            <!-- SECTION: RADEON CHILL -->
                            <TextBlock Text="RADEON CHILL" Style="{StaticResource SectionHeaderTextStyle}"/>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Border.Resources>
                                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#ED1C24"/>
                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#D01820"/>
                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#B8141C"/>
                                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#ED1C24"/>
                                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#D01820"/>
                                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#B8141C"/>
                                </Border.Resources>
                                <StackPanel>
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock x:Name="AMDRadeonChillText" Text="Radeon Chill" FontWeight="SemiBold" FontSize="15"
                                                TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            <TextBlock Text="Power-saving dynamic FPS regulation" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="AMDRadeonChillToggle" IsEnabled="False" OffContent="Disabled" OnContent="Enabled"
                                            VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                    
                                    <StackPanel Visibility="{Binding ElementName=AMDRadeonChillToggle, Path=IsOn, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,0,0">
                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,4,0,8"/>
                                        
                                        <TextBlock x:Name="AMDRadeonChillMinFPSText" Text="{Binding ElementName=AMDRadeonChillMinFPSSlider, Path=Value, Converter={StaticResource RadeonChillMinFPSStringConverter}}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                                        <Slider x:Name="AMDRadeonChillMinFPSSlider"
                                            Minimum="30" Maximum="300"
                                            TickFrequency="5"
                                            SnapsTo="Ticks"
                                            TickPlacement="BottomRight"
                                            IsEnabled="False"/>
                                            
                                        <TextBlock x:Name="AMDRadeonChillMaxFPSText" Text="{Binding ElementName=AMDRadeonChillMaxFPSSlider, Path=Value, Converter={StaticResource RadeonChillMaxFPSStringConverter}}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        <Slider x:Name="AMDRadeonChillMaxFPSSlider"
                                            Minimum="30" Maximum="300"
                                            TickFrequency="5"
                                            SnapsTo="Ticks"
                                            TickPlacement="BottomRight"
                                            IsEnabled="False"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>

                <!-- NVIDIA SETTINGS TAB (GeForce Green Themed) -->
                <PivotItem x:Name="NvidiaPivotItem">
                    <PivotItem.Header>
                        <StackPanel x:Name="NvidiaPivotItemStackPanel" Orientation="Horizontal" Margin="6,0,24,0">
                            <FontIcon Glyph="&#xE9D9;" Margin="0,0,8,0" FontSize="15" VerticalAlignment="Center" Foreground="{StaticResource GeForceGreenBrush}"/>
                            <TextBlock Text="NVIDIA" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </PivotItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" XYFocusKeyboardNavigation="Enabled">
                        <StackPanel Margin="0,8,0,16">

                            <!-- SECTION: NVIDIA APP -->
                            <TextBlock Text="NVIDIA SOFTWARE" Style="{StaticResource SectionHeaderTextStyle}"/>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid Margin="0,2,0,2">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock x:Name="NvidiaAppText" Text="NVIDIA App" FontWeight="SemiBold" FontSize="15"
                                            TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        <TextBlock Text="Open NVIDIA App / GeForce Experience overlay" Style="{StaticResource SubtitleTextStyle}"/>
                                    </StackPanel>
                                    <Button x:Name="LaunchNvidiaAppButton" Content="Open" Width="140" HorizontalAlignment="Right" Click="LaunchNvidiaAppButton_Click"
                                        Background="#76B900" Foreground="Black" FontWeight="Bold" CornerRadius="6"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
            </Pivot>

            <!-- Thin line below the tabs -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="0,0,0,1" 
                    VerticalAlignment="Top" 
                    Margin="0,0,0,0"
                    Height="48" 
                    IsHitTestVisible="False"/>
        </Grid>
    </Grid>

</Page>
