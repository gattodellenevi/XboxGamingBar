                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Margin="5,0,0,6" Padding="12,10,12,10" CornerRadius="8"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        XYFocusLeft="{x:Bind QuickOSDToggleButton}"
                                        Click="QuickFPSLimitToggleButton_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="QuickFPSLimitIconBorder" Grid.Column="0" Width="32" Height="32" CornerRadius="6" 
                                                Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" 
                                                Margin="0,0,10,0" VerticalAlignment="Center">
                                            <FontIcon x:Name="QuickFPSLimitIcon" Glyph="&#xEDA7;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                      Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <TextBlock Text="Frame Limiter" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="QuickFPSLimitSubtitleText" Text="Disabled" Style="{StaticResource SubtitleTextStyle}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border x:Name="QuickFPSLimitBadge" Grid.Column="2" VerticalAlignment="Center"
                                                Style="{StaticResource ValueBadgeStyle}" Padding="6,2,6,2"
                                                Background="#3A3A3A" BorderBrush="#3A3A3A">
                                            <TextBlock x:Name="QuickFPSLimitBadgeText" Text="OFF" Style="{StaticResource ValueBadgeTextStyle}" Foreground="#CCCCCC"/>
                                        </Border>
                                    </Grid>
                                </Button>

                                <!-- Row 2: HDR Quick Toggle -->
                                <Button x:Name="QuickHDRToggleButton" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Margin="0,0,0,0" Padding="12,10,12,10" CornerRadius="8"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Click="QuickHDRToggleButton_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="QuickHDRIconBorder" Grid.Column="0" Width="32" Height="32" CornerRadius="6" 
                                                Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" 
                                                Margin="0,0,10,0" VerticalAlignment="Center">
                                            <FontIcon x:Name="QuickHDRIcon" Glyph="&#xE793;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                      Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <TextBlock Text="HDR (High Dynamic Range)" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="QuickHDRSubtitleText" Text="Disabled" Style="{StaticResource SubtitleTextStyle}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border x:Name="QuickHDRBadge" Grid.Column="2" VerticalAlignment="Center"
                                                Style="{StaticResource ValueBadgeStyle}" Padding="6,2,6,2"
                                                Background="#3A3A3A" BorderBrush="#3A3A3A">
                                            <TextBlock x:Name="QuickHDRBadgeText" Text="OFF" Style="{StaticResource ValueBadgeTextStyle}" Foreground="#CCCCCC"/>
                                        </Border>
                                    </Grid>
                                </Button>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>

                <!-- PERFORMANCE TAB -->
                <PivotItem x:Name="PerformancePivotItem">
                    <PivotItem.Header>
                        <StackPanel Orientation="Horizontal" Margin="6,0,6,0">
                            <FontIcon Glyph="&#xE9D2;" Margin="0,0,8,0" FontSize="15" VerticalAlignment="Center" Foreground="{StaticResource XboxGreenBrush}"/>
                            <TextBlock Text="Performance" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </PivotItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" XYFocusKeyboardNavigation="Enabled">
                        <StackPanel Margin="0,2,0,16">

                            <!-- SECTION: LIVE HARDWARE METRICS (SINGLE ROW STRIP) -->
                            <Border Style="{StaticResource SettingsCardStyle}" Margin="10,2,10,12" Padding="6,10,6,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- Column 1: CPU -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- Divider 1 -->
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- Column 2: RAM -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- Divider 2 -->
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- Column 3: GPU -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- Divider 3 -->
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- Column 4: VRAM -->
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 1. CPU COLUMN -->
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <Border Background="#2600D2B4" CornerRadius="4" Padding="6,2,6,2" HorizontalAlignment="Center" Margin="0,0,0,4">
                                            <TextBlock Text="CPU" FontSize="10" FontWeight="Bold" Foreground="#00D2B4"/>
                                        </Border>
                                        <TextBlock x:Name="LiveCPUUsageText" Text="--%" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="LiveCPUWattageText" Text="--W" FontSize="11"
                                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Vertical Divider 1 -->
                                    <Border Grid.Column="1" Width="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,4,2,4"/>

                                    <!-- 2. RAM COLUMN -->
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <Border Background="#26FF69B4" CornerRadius="4" Padding="6,2,6,2" HorizontalAlignment="Center" Margin="0,0,0,4">
                                            <TextBlock Text="RAM" FontSize="10" FontWeight="Bold" Foreground="#FF69B4"/>
                                        </Border>
                                        <TextBlock x:Name="LiveRAMUsageText" Text="--%" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="LiveRAMUsedText" Text="-- GB" FontSize="11"
                                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Vertical Divider 2 -->
                                    <Border Grid.Column="3" Width="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,4,2,4"/>

                                    <!-- 3. GPU COLUMN -->
                                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                        <Border Background="#267CFC00" CornerRadius="4" Padding="6,2,6,2" HorizontalAlignment="Center" Margin="0,0,0,4">
                                            <TextBlock Text="GPU" FontSize="10" FontWeight="Bold" Foreground="#7CFC00"/>
                                        </Border>
                                        <TextBlock x:Name="LiveGPUUsageText" Text="--%" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="LiveGPUWattageText" Text="--W" FontSize="11"
                                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Vertical Divider 3 -->
                                    <Border Grid.Column="5" Width="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,4,2,4"/>

                                    <!-- 4. VRAM COLUMN -->
                                    <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                                        <Border Background="#26BA55D3" CornerRadius="4" Padding="6,2,6,2" HorizontalAlignment="Center" Margin="0,0,0,4">
                                            <TextBlock Text="VRAM" FontSize="10" FontWeight="Bold" Foreground="#BA55D3"/>
                                        </Border>
                                        <TextBlock x:Name="LiveVRAMUsageText" Text="--%" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="LiveVRAMUsedText" Text="-- GB" FontSize="11"
                                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- CARD: MONITORED GPU SELECTION (Only visible if dual GPUs present) -->
                            <Border x:Name="GpuSelectionCard" Style="{StaticResource SettingsCardStyle}" Margin="10,0,10,12" Padding="12,8,12,8" Visibility="Collapsed">
                                <Grid Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock x:Name="GpuSelectionTitleText" Text="Monitored GPU" FontWeight="SemiBold" FontSize="15"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        <TextBlock x:Name="GpuSelectionSubtitleText" Text="Select GPU to monitor in performance strip" Style="{StaticResource SubtitleTextStyle}"/>
                                    </StackPanel>

                                    <!-- Segmented Pill Selector -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                                        <Button x:Name="DiscreteGpuButton"
                                                Click="DiscreteGpuButton_Click"
                                                CornerRadius="6" Padding="10,5,10,5"
                                                XYFocusRight="{x:Bind IntegratedGpuButton}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE7FC;" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="DiscreteGpuButtonText" Text="Discrete" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="IntegratedGpuButton"
                                                Click="IntegratedGpuButton_Click"
                                                CornerRadius="6" Padding="10,5,10,5"
                                                XYFocusLeft="{x:Bind DiscreteGpuButton}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE950;" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="IntegratedGpuButtonText" Text="Integrated" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- SECTION: OVERLAY -->
                            <TextBlock Text="OVERLAY" Style="{StaticResource SectionHeaderTextStyle}"/>
                            
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel XYFocusKeyboardNavigation="Enabled">
                                    <Grid Margin="0,0,0,8">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="PerformanceOverlayText" Text="Performance Overlay" FontWeight="SemiBold" FontSize="15"
                                                    TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>

                                                <!-- Elevation Mismatch Warning Badge (Amber) -->
                                                <Border x:Name="OSDElevationWarningBadge" Style="{StaticResource ValueBadgeStyle}" Margin="8,0,0,0"
                                                        Background="#2D2305" BorderBrush="#CA8A04" Visibility="Collapsed">
                                                    <TextBlock Text="ADMIN REQUIRED" Style="{StaticResource ValueBadgeTextStyle}" Foreground="#F59E0B"/>
                                                </Border>

                                                <!-- RTSS Offline / Not Running Warning Badge (Amber) -->
                                                <Border x:Name="OSDRTSSWarningBadge" Style="{StaticResource ValueBadgeStyle}" Margin="8,0,0,0"
                                                        Background="#2D2305" BorderBrush="#CA8A04" Visibility="Collapsed">
                                                    <TextBlock x:Name="OSDRTSSWarningBadgeText" Text="RTSS NOT RUNNING" Style="{StaticResource ValueBadgeTextStyle}" Foreground="#F59E0B"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="OSDSubtitleText" Text="RTSS / ADLX in-game metrics overlay" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Inline RTSS Offline / Not Running Warning Banner -->
                                    <Border x:Name="OSDRTSSWarningCard"
                                            Background="#2D2305" BorderBrush="#CA8A04" BorderThickness="1"
                                            CornerRadius="6" Padding="12,10,12,10" Margin="0,2,0,8"
                                            Visibility="Collapsed">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                                <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="OSDRTSSWarningTitleText" Text="RTSS is Not Running" FontWeight="SemiBold" FontSize="13" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            
                                            <TextBlock x:Name="OSDRTSSWarningDescText"
                                                       Text="RivaTuner Statistics Server is required for on-screen metrics display. Start RTSS to enable the overlay."
                                                       Style="{StaticResource SubtitleTextStyle}"
                                                       Foreground="#D0D0D0"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,2"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Inline Elevation Mismatch Warning Banner -->
                                    <Border x:Name="OSDElevationWarningCard"
                                            Background="#2D2305" BorderBrush="#CA8A04" BorderThickness="1"
                                            CornerRadius="6" Padding="12,10,12,10" Margin="0,2,0,8"
                                            Visibility="Collapsed">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                                <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Elevation Mismatch" FontWeight="SemiBold" FontSize="13" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            
                                            <TextBlock Text="RTSS is running as Administrator, but the Helper is running with standard privileges. Windows blocks the Helper from updating the RTSS overlay across integrity levels."
                                                       Style="{StaticResource SubtitleTextStyle}"
                                                       Foreground="#D0D0D0"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,10"/>

                                            <Button x:Name="OSDRestartElevatedButton"
                                                    HorizontalAlignment="Stretch"
                                                    Padding="10,6,10,6"
                                                    CornerRadius="6"
                                                    Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Click="RestartElevatedButton_Click">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <FontIcon Glyph="&#xE7EF;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource XboxGreenBrush}"/>
                                                    <TextBlock Text="Restart Helper as Administrator" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel x:Name="OSDControlsContainer">
                                        <!-- Segmented Quick Selector Bar -->
                                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,2,0,4">
                                        <Grid x:Name="OSDSegmentedGrid">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Button x:Name="OSDLevel0Button" Grid.Column="0" Content="OFF" Tag="0" 
                                                    Style="{StaticResource SegmentedButtonStyle}" Click="OSDLevelButton_Click"
                                                    IsEnabled="{Binding ElementName=PerformanceOverlaySlider, Path=IsEnabled}"
                                                    XYFocusRight="{Binding ElementName=OSDLevel1Button}"/>

                                            <Button x:Name="OSDLevel1Button" Grid.Column="1" Content="FPS" Tag="1" 
                                                    Style="{StaticResource SegmentedButtonStyle}" Click="OSDLevelButton_Click"
                                                    IsEnabled="{Binding ElementName=PerformanceOverlaySlider, Path=IsEnabled}"
                                                    XYFocusLeft="{Binding ElementName=OSDLevel0Button}"
                                                    XYFocusRight="{Binding ElementName=OSDLevel2Button}"/>

                                            <Button x:Name="OSDLevel2Button" Grid.Column="2" Content="DETAIL" Tag="2" 
                                                    Style="{StaticResource SegmentedButtonStyle}" Click="OSDLevelButton_Click"
                                                    IsEnabled="{Binding ElementName=PerformanceOverlaySlider, Path=IsEnabled}"
                                                    XYFocusLeft="{Binding ElementName=OSDLevel1Button}"
                                                    XYFocusRight="{Binding ElementName=OSDLevel3Button}"/>

                                            <Button x:Name="OSDLevel3Button" Grid.Column="3" Content="FULL" Tag="3" 
                                                    Style="{StaticResource SegmentedButtonStyle}" Click="OSDLevelButton_Click"
                                                    IsEnabled="{Binding ElementName=PerformanceOverlaySlider, Path=IsEnabled}"
                                                    XYFocusLeft="{Binding ElementName=OSDLevel2Button}"
                                                    XYFocusRight="{Binding ElementName=OSDLevel4Button}"/>

                                            <Button x:Name="OSDLevel4Button" Grid.Column="4" Content="ALL" Tag="4" 
                                                    Style="{StaticResource SegmentedButtonStyle}" Click="OSDLevelButton_Click"
                                                    IsEnabled="{Binding ElementName=PerformanceOverlaySlider, Path=IsEnabled}"
                                                    XYFocusLeft="{Binding ElementName=OSDLevel3Button}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Underlying Slider (Preserved for OSDProperty compatibility) -->
                                    <Slider x:Name="PerformanceOverlaySlider"
                                        Minimum="0" Maximum="4"
                                        TickFrequency="1"
                                        SnapsTo="StepValues"
                                        TickPlacement="None"
                                        IsEnabled="False"
                                        Height="0"
                                        Opacity="0"
                                        Margin="0"
                                        IsHitTestVisible="False"/>

                                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,10,0,10"/>

                                    <Grid Margin="0,2,0,2">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="OverlayTextSizeText" Text="Text Size" FontWeight="SemiBold" FontSize="15"
                                                    TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <Border Style="{StaticResource ValueBadgeStyle}" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding ElementName=OverlayTextSizeSlider, Path=Value, Converter={StaticResource OSDTextSizeStringConverter}}" 
                                                               Style="{StaticResource ValueBadgeTextStyle}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Scale overlay typography (relative to resolution)" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Slider x:Name="OverlayTextSizeSlider"
                                        Minimum="50" Maximum="200"
                                        StepFrequency="10"
                                        TickFrequency="10"
                                        SnapsTo="StepValues"
                                        TickPlacement="None"
                                        Margin="0,2,0,2"
                                        IsEnabled="False"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- SECTION: FRAME PACING -->
                            <TextBlock Text="FRAME PACING" Style="{StaticResource SectionHeaderTextStyle}"/>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel XYFocusKeyboardNavigation="Enabled">
                                    <!-- Frame Limiter Toggle Row with Header Value Badge -->
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="FPSLimitText" Text="Frame Limiter" FontWeight="SemiBold" FontSize="15"
                                                    TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                
                                                <!-- Standard Value Badge (Shown when active and no mismatch) -->
                                                <Border x:Name="FPSLimitValueBadge" Style="{StaticResource ValueBadgeStyle}" Margin="8,0,0,0"
                                                        Visibility="Collapsed">
                                                    <TextBlock x:Name="FPSLimitValueBadgeText"
                                                               Text="{Binding ElementName=FPSLimitSlider, Path=Value, Converter={StaticResource FPSStringConverter}}" 
                                                               Style="{StaticResource ValueBadgeTextStyle}"/>
                                                </Border>

                                                <!-- Elevation Mismatch Warning Badge (Amber) -->
                                                <Border x:Name="FPSLimitElevationWarningBadge" Style="{StaticResource ValueBadgeStyle}" Margin="8,0,0,0"
                                                        Background="#2D2305" BorderBrush="#CA8A04" Visibility="Collapsed">
                                                    <TextBlock Text="ADMIN REQUIRED" Style="{StaticResource ValueBadgeTextStyle}" Foreground="#F59E0B"/>
                                                </Border>

                                                <!-- RTSS Offline / Not Running Warning Badge (Amber) -->
                                                <Border x:Name="FPSLimitRTSSWarningBadge" Style="{StaticResource ValueBadgeStyle}" Margin="8,0,0,0"
                                                        Background="#2D2305" BorderBrush="#CA8A04" Visibility="Collapsed">
                                                    <TextBlock x:Name="FPSLimitRTSSWarningBadgeText" Text="RTSS NOT RUNNING" Style="{StaticResource ValueBadgeTextStyle}" Foreground="#F59E0B"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="FPSLimitSubtitleText" Text="Cap framerate via RTSS to stabilize frametimes" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="LimitFPSToggle" IsEnabled="False" 
                                            OffContent="Disabled" OnContent="Enabled"
                                            VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Inline RTSS Offline / Not Running Warning Banner -->
                                    <Border x:Name="FPSLimitRTSSWarningCard"
                                            Background="#2D2305" BorderBrush="#CA8A04" BorderThickness="1"
                                            CornerRadius="6" Padding="12,10,12,10" Margin="0,10,0,2"
                                            Visibility="Collapsed">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                                <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="FPSLimitRTSSWarningTitleText" Text="RTSS is Not Running" FontWeight="SemiBold" FontSize="13" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            
                                            <TextBlock x:Name="FPSLimitRTSSWarningDescText"
                                                       Text="RivaTuner Statistics Server is required for framerate limiting and frame pacing. Start RTSS to enable framerate controls."
                                                       Style="{StaticResource SubtitleTextStyle}"
                                                       Foreground="#D0D0D0"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,2"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Inline Elevation Mismatch Warning Banner -->
                                    <Border x:Name="FPSLimitElevationWarningCard"
                                            Background="#2D2305" BorderBrush="#CA8A04" BorderThickness="1"
                                            CornerRadius="6" Padding="12,10,12,10" Margin="0,10,0,2"
                                            Visibility="Collapsed">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                                <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Elevation Mismatch" FontWeight="SemiBold" FontSize="13" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            
                                            <TextBlock Text="RTSS is running as Administrator, but the Helper is running with standard privileges. Windows blocks the Helper from modifying RTSS frame limits across integrity levels."
                                                       Style="{StaticResource SubtitleTextStyle}"
                                                       Foreground="#D0D0D0"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,10"/>

                                            <Button x:Name="FPSLimitRestartElevatedButton"
                                                    HorizontalAlignment="Stretch"
                                                    Padding="10,6,10,6"
                                                    CornerRadius="6"
                                                    Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Click="RestartElevatedButton_Click">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <FontIcon Glyph="&#xE7EF;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource XboxGreenBrush}"/>
                                                    <TextBlock Text="Restart Helper as Administrator" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- Expanded Frame Limiter Settings -->
                                    <StackPanel x:Name="FPSLimitSettingsContainer" Visibility="Collapsed">
                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,10,0,10"/>

                                        <Slider x:Name="FPSLimitSlider"
                                            Minimum="30" Maximum="120"
                                            TickFrequency="1"
                                            SnapsTo="Ticks"
                                            TickPlacement="BottomRight"
                                            IsEnabled="False"/>

                                        <Slider x:Name="FPSLimitJudderFreeSlider"
                                            Minimum="0" Maximum="1"
                                            StepFrequency="1"
                                            TickFrequency="1"
                                            SnapsTo="StepValues"
                                            TickPlacement="None"
                                            IsEnabled="{Binding ElementName=FPSLimitSlider, Path=IsEnabled}"
                                            Visibility="Collapsed"/>

                                        <Canvas x:Name="FPSLimitJudderFreeCanvas" Height="24" Margin="10,-6,10,4"/>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,4,0,10"/>

                                        <!-- Judder Free Toggle -->
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock x:Name="JudderFreeFPSText" Text="Judder Free FPS" FontWeight="Normal" FontSize="14"/>
                                                <TextBlock Text="Snap slider to refresh rate divisors" Style="{StaticResource SubtitleTextStyle}"/>
                                            </StackPanel>
                                            <ToggleSwitch x:Name="JudderFreeFPSToggle" OffContent="All" OnContent="Judder Free"
                                                VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <!-- Limiter Mode ComboBox -->
                                        <Grid Margin="0,4,0,2">
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock x:Name="FPSLimitModeText" Text="Limiter Mode" FontWeight="Normal" FontSize="14"/>
                                                <TextBlock Text="RTSS frame synchronization method" Style="{StaticResource SubtitleTextStyle}"/>
                                            </StackPanel>
                                            <ComboBox x:Name="FPSLimitModeComboBox" SelectedIndex="0" HorizontalAlignment="Right" VerticalAlignment="Center" Width="140" IsEnabled="False">
                                                <ComboBoxItem Content="Async"/>
                                                <ComboBoxItem Content="Front Edge Sync"/>
                                                <ComboBoxItem Content="Back Edge Sync"/>
                                                <ComboBoxItem Content="NVIDIA Reflex"/>
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>

                <!-- SHORTCUTS TAB -->
                <PivotItem x:Name="ShortcutsPivotItem">
                    <PivotItem.Header>
                        <StackPanel Orientation="Horizontal" Margin="6,0,6,0">
                            <FontIcon Glyph="&#xE765;" Margin="0,0,8,0" FontSize="15" VerticalAlignment="Center" Foreground="{StaticResource XboxGreenBrush}"/>
                            <TextBlock Text="Shortcuts" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </PivotItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" XYFocusKeyboardNavigation="Enabled">
                        <StackPanel Margin="0,2,0,16">

                            <!-- SECTION: SHORTCUT BUTTONS -->
                            <TextBlock Text="SHORTCUTS" Style="{StaticResource SectionHeaderTextStyle}"/>

                            <Border Style="{StaticResource SettingsCardStyle}" Padding="10,10,10,10">
                                <StackPanel>
                                    <!-- Empty state placeholder -->
                                    <StackPanel x:Name="NoShortcutsPlaceholder" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,16,0,16">
                                        <FontIcon Glyph="&#xE765;" FontSize="28" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="No shortcuts configured" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Click 'Add New Shortcut' below to create one" Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Grid of square shortcut buttons (4 per row) -->
                                    <GridView x:Name="ShortcutsGridView" 
                                              SelectionMode="None" 
                                              IsItemClickEnabled="True"
                                              ItemClick="ShortcutsGridView_ItemClick"
                                              PreviewKeyDown="ShortcutsGridView_PreviewKeyDown"
                                              XYFocusKeyboardNavigation="Enabled"
                                              HorizontalAlignment="Center">
                                        <GridView.ItemContainerStyle>
                                            <Style TargetType="GridViewItem">
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                <Setter Property="MinWidth" Value="0"/>
                                                <Setter Property="MinHeight" Value="0"/>
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </GridView.ItemContainerStyle>
                                        <GridView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="-1" ItemWidth="105" ItemHeight="105"/>
                                            </ItemsPanelTemplate>
                                        </GridView.ItemsPanel>
                                        <GridView.ItemTemplate>
                                            <DataTemplate>
                                                <Button Click="ShortcutButton_Click"
                                                        RightTapped="ShortcutButton_RightTapped"
                                                        Holding="ShortcutButton_Holding"
                                                        IsTabStop="False"
                                                        Tag="{Binding}"
                                                        Width="98" Height="98"
                                                        Margin="2,2,2,2"
                                                        Padding="4,6,4,6"
                                                        CornerRadius="8"
                                                        Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <Button.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="Execute" Click="MenuExecute_Click" Tag="{Binding}">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE768;"/>
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Edit" Click="MenuEdit_Click" Tag="{Binding}">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE70F;"/>
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Delete" Click="MenuDelete_Click" Tag="{Binding}">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE74D;"/>
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                        </MenuFlyout>
                                                    </Button.ContextFlyout>
                                                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <!-- Icon -->
                                                        <FontIcon Grid.Row="0" Glyph="{Binding IconGlyph}" FontSize="22" Foreground="{StaticResource XboxGreenBrush}" HorizontalAlignment="Center" Margin="0,2,0,2"/>
                                                        <!-- Name -->
                                                        <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"/>
                                                        <!-- Hotkey Badge -->
                                                        <Border Grid.Row="2" Style="{StaticResource ValueBadgeStyle}" HorizontalAlignment="Center" Padding="5,1,5,1" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding DisplayKeyCombo}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>
                                </StackPanel>
                            </Border>

                            <!-- SECTION: ADD SHORTCUT BUTTON -->
                            <Border Style="{StaticResource SettingsCardStyle}" Margin="10,0,10,10" Padding="0">
                                <Button x:Name="AddShortcutButton" 
                                        HorizontalAlignment="Stretch" 
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent" 
                                        BorderThickness="0"
                                        Padding="14,12,14,12"
                                        Click="AddShortcutButton_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" 
                                                Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" 
                                                Margin="0,0,12,0" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE710;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                      Foreground="{StaticResource XboxGreenBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Add New Shortcut" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="Create custom key combinations and game hotkeys" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>

                <!-- CURSOR TAB -->
                <PivotItem x:Name="CursorPivotItem">
                    <PivotItem.Header>
                        <StackPanel Orientation="Horizontal" Margin="6,0,6,0">
                            <FontIcon Glyph="&#xE962;" Margin="0,0,8,0" FontSize="15" VerticalAlignment="Center" Foreground="{StaticResource XboxGreenBrush}"/>
                            <TextBlock Text="Cursor" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </PivotItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" XYFocusKeyboardNavigation="Enabled">
                        <StackPanel Margin="0,2,0,16">

                            <!-- SECTION: MOUSE POINTER -->
                            <TextBlock Text="GAMEPAD &amp; MOUSE CURSOR" Style="{StaticResource SectionHeaderTextStyle}"/>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <!-- Mouse Speed Slider -->
                                    <Grid Margin="0,2,0,2">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="MouseSpeedText" Text="Cursor Speed" FontWeight="SemiBold" FontSize="15"
                                                    TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <Border Style="{StaticResource ValueBadgeStyle}" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding ElementName=MouseSpeedSlider, Path=Value}" 
                                                               Style="{StaticResource ValueBadgeTextStyle}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Speed of mouse pointer and Game Bar gamepad cursor" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Slider x:Name="MouseSpeedSlider"
                                        Minimum="1" Maximum="20"
                                        StepFrequency="1"
                                        TickFrequency="1"
                                        SnapsTo="StepValues"
                                        TickPlacement="None"
                                        Margin="0,6,0,6"
                                        IsEnabled="False"/>

                                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,10,0,10"/>

                                    <!-- Scrolling Speed Slider -->
                                    <Grid Margin="0,2,0,2">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="MouseScrollSpeedText" Text="Scrolling Speed" FontWeight="SemiBold" FontSize="15"
                                                    TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <Border Style="{StaticResource ValueBadgeStyle}" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding ElementName=MouseScrollSpeedSlider, Path=Value}" 
                                                               Style="{StaticResource ValueBadgeTextStyle}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Lines to scroll per wheel notch or stick tilt" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Slider x:Name="MouseScrollSpeedSlider"
                                        Minimum="1" Maximum="20"
                                        StepFrequency="1"
                                        TickFrequency="1"
                                        SnapsTo="StepValues"
                                        TickPlacement="None"
                                        Margin="0,6,0,6"
                                        IsEnabled="False"/>

                                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,10,0,10"/>

                                    <!-- Enhance Pointer Precision (Mouse Acceleration) -->
                                    <Grid Margin="0,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock x:Name="EnhancePointerPrecisionText" Text="Enhance Pointer Precision" FontWeight="SemiBold" FontSize="15"
                                                TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            <TextBlock Text="Dynamic pointer acceleration for gamepad cursor and mouse" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="EnhancePointerPrecisionToggle" Grid.Column="1"
                                            VerticalAlignment="Center" HorizontalAlignment="Right"
                                            OnContent="On" OffContent="Off"
                                            IsEnabled="False"/>
                                    </Grid>

                                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,10,0,10"/>

                                    <!-- Game Bar Gamepad Cursor Setting -->
                                    <Grid Margin="0,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock x:Name="GamepadCursorSettingTitleText" Text="Game Bar Gamepad Cursor" FontWeight="SemiBold" FontSize="15"
                                                TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            <TextBlock x:Name="GamepadCursorSettingSubtitleText" Text="Configure stick cursor navigation, button clicks, and auto-activation in Game Bar" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                        <Button x:Name="OpenGamepadCursorSettingsButton" Grid.Column="1"
                                                VerticalAlignment="Center" Padding="12,6,12,6"
                                                CornerRadius="6"
                                                Click="OpenGamepadCursorSettingsButton_Click"
                                                ToolTipService.ToolTip="Open Game Bar Gamepad Cursor settings">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE713;" FontSize="13" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="OpenGamepadCursorSettingsButtonText" Text="Open" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECTION: ON-SCREEN KEYBOARD -->
                            <TextBlock Text="ON-SCREEN KEYBOARD" Style="{StaticResource SectionHeaderTextStyle}"/>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock x:Name="VirtualKeyboardTitleText" Text="Touch / Virtual Keyboard" FontWeight="SemiBold" FontSize="15"
                                                TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            <TextBlock x:Name="VirtualKeyboardSubtitleText" Text="Open Windows virtual keyboard for text input without a physical keyboard" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                        <Button x:Name="OpenVirtualKeyboardButton" Grid.Column="1"
                                                VerticalAlignment="Center" Padding="12,6,12,6"
                                                CornerRadius="6"
                                                Click="OpenVirtualKeyboardButton_Click"
                                                ToolTipService.ToolTip="Summon the Windows Touch Keyboard or On-Screen Keyboard">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE765;" FontSize="13" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="OpenVirtualKeyboardButtonText" Text="Open" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECTION: GAMEINPUT SERVICE -->
                            <TextBlock Text="GAMEINPUT SERVICE" Style="{StaticResource SectionHeaderTextStyle}"/>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <!-- GameInput Service Row -->
                                    <Grid Margin="0,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="GameInputStatusTitleText" Text="GameInput Service" FontWeight="SemiBold" FontSize="15"
                                                    TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <Border x:Name="GameInputStatusBadge" Style="{StaticResource ValueBadgeStyle}" Margin="8,0,0,0"
                                                        Background="#5A5A5A" BorderBrush="#5A5A5A">
                                                    <TextBlock x:Name="GameInputStatusBadgeText" Text="OFFLINE" 
                                                               Style="{StaticResource ValueBadgeTextStyle}" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="GameInputStatusSubtitleText" Text="Powers Game Bar gamepad cursor and controller navigation" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                        <Button x:Name="RestartGameInputServiceButton" Grid.Column="1"
                                                VerticalAlignment="Center" Padding="10,6,10,6"
                                                CornerRadius="6"
                                                Click="RestartGameInputServiceButton_Click"
                                                ToolTipService.ToolTip="Restart service if Gamepad Cursor mode is enabled in Game Bar but the cursor doesn't move">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE72C;" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="RestartGameInputServiceButtonText" Text="Restart" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>

                <!-- SYSTEM TAB -->
                <PivotItem x:Name="SystemPivotItem">
                    <PivotItem.Header>
                        <StackPanel Orientation="Horizontal" Margin="6,0,6,0">
                            <FontIcon Glyph="&#xE770;" Margin="0,0,8,0" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Text="System" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </PivotItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" XYFocusKeyboardNavigation="Enabled">
                        <StackPanel Margin="0,2,0,16">

                            <!-- SECTION: DISPLAY -->
                            <TextBlock Text="DISPLAY" Style="{StaticResource SectionHeaderTextStyle}"/>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,2,0,2">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock x:Name="RefreshRatesText" Text="Refresh Rate" FontWeight="SemiBold" FontSize="15"
                                                TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            <TextBlock Text="Active display refresh rate (Hz)" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="RefreshRatesComboBox" PlaceholderText="60 Hz" Width="140" IsEnabled="False" HorizontalAlignment="Right">
                                            <x:String>60 Hz</x:String>
                                        </ComboBox>
                                    </Grid>

                                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,10,0,10"/>

                                    <Grid Margin="0,2,0,2">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock x:Name="ResolutionsText" Text="Resolution" FontWeight="SemiBold" FontSize="15"
                                                TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            <TextBlock Text="Active screen display resolution" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="ResolutionsComboBox" PlaceholderText="1920x1080" Width="140" IsEnabled="False" HorizontalAlignment="Right">
                                            <x:String>1920x1080</x:String>
                                        </ComboBox>
                                    </Grid>

                                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,10,0,10"/>

                                    <Grid Margin="0,2,0,2">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock x:Name="HDRText" Text="HDR" FontWeight="SemiBold" FontSize="15"
                                                TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            <TextBlock x:Name="HDRSubtitleText" Text="High Dynamic Range display" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="HDRToggle" IsOn="False" IsEnabled="False" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECTION: BACKGROUND SERVICES -->
                            <TextBlock Text="BACKGROUND SERVICES" Style="{StaticResource SectionHeaderTextStyle}"/>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <!-- Helper Process Row -->
                                    <Grid Margin="0,2,0,2">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="HelperStatusTitleText" Text="Helper Process" FontWeight="SemiBold" FontSize="15"
                                                    TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <Border x:Name="HelperElevationBadge" Style="{StaticResource ValueBadgeStyle}" Margin="8,0,0,0"
                                                        Background="#5A5A5A" BorderBrush="#5A5A5A">
                                                    <TextBlock x:Name="HelperElevationBadgeText" Text="OFFLINE" 
                                                               Style="{StaticResource ValueBadgeTextStyle}" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="HelperStatusSubtitleText" Text="Helper process is not running or disconnected" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Divider between Helper and RTSS -->
                                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,10,0,10"/>

                                    <!-- RTSS Process Row -->
                                    <Grid Margin="0,2,0,2">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="RTSSStatusTitleText" Text="RTSS Process" FontWeight="SemiBold" FontSize="15"
                                                    TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <Border x:Name="RTSSElevationBadge" Style="{StaticResource ValueBadgeStyle}" Margin="8,0,0,0"
                                                        Background="#5A5A5A" BorderBrush="#5A5A5A">
                                                    <TextBlock x:Name="RTSSElevationBadgeText" Text="OFFLINE" 
                                                               Style="{StaticResource ValueBadgeTextStyle}" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="RTSSStatusSubtitleText" Text="RivaTuner Statistics Server is not running" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Divider between RTSS and Hardware Monitor -->
                                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,10,0,10"/>

                                    <!-- Hardware Monitor Row -->
                                    <Grid Margin="0,2,0,2">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="HardwareProviderTitleText" Text="Hardware Monitor" FontWeight="SemiBold" FontSize="15"
                                                    TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <Border x:Name="HardwareProviderBadge" Style="{StaticResource ValueBadgeStyle}" Margin="8,0,0,0"
                                                        Background="#5A5A5A" BorderBrush="#5A5A5A">
                                                    <TextBlock x:Name="HardwareProviderBadgeText" Text="OFFLINE" 
                                                               Style="{StaticResource ValueBadgeTextStyle}" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="HardwareProviderSubtitleText" Text="Helper process is not running or disconnected" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Divider between Hardware Monitor and Controller -->
                                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,10,0,10"/>

                                    <!-- Gamepad Battery Row -->
                                    <Grid Margin="0,2,0,2">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="ControllerBatteryTitleText" Text="Gamepad Battery" FontWeight="SemiBold" FontSize="15"
                                                    TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <Border x:Name="ControllerBatteryStatusBadge" Style="{StaticResource ValueBadgeStyle}" Margin="8,0,0,0"
                                                        Background="#5A5A5A" BorderBrush="#5A5A5A">
                                                    <TextBlock x:Name="ControllerBatteryStatusBadgeText" Text="DISCONNECTED" 
                                                               Style="{StaticResource ValueBadgeTextStyle}" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="ControllerBatteryStatusSubtitleText" Text="No game controller detected" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- APPLICATION VERSION FOOTER -->
                            <StackPanel HorizontalAlignment="Center" Margin="0,24,0,8" Opacity="0.65">
                                <TextBlock x:Name="AppVersionText" Text="CouchGamingBar" FontSize="11" 
                                           HorizontalAlignment="Center"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>

                <!-- AMD SETTINGS TAB (Radeon Ruby Themed) -->
                <PivotItem x:Name="AMDPivotItem" Visibility="Collapsed">
                    <PivotItem.Header>
                        <StackPanel x:Name="AMDPivotItemStackPanel" Orientation="Horizontal" Margin="6,0,6,0" Visibility="Collapsed">
                            <FontIcon Glyph="&#xE945;" Margin="0,0,8,0" FontSize="15" VerticalAlignment="Center" Foreground="{StaticResource RadeonRubyBrush}"/>
                            <TextBlock Text="AMD" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </PivotItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" XYFocusKeyboardNavigation="Enabled">
                        <StackPanel Margin="0,2,0,16">

                            <!-- SECTION: UPSCALING & FRAME GEN -->
                            <TextBlock Text="RADEON UPSCALING &amp; FRAMES" Style="{StaticResource SectionHeaderTextStyle}"/>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Border.Resources>
                                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#ED1C24"/>
                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#D01820"/>
                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#B8141C"/>
                                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#ED1C24"/>
                                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#D01820"/>
                                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#B8141C"/>
                                </Border.Resources>
                                <StackPanel>
                                    <!-- RSR with Value Badge -->
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="AMDRadeonSuperResolutionText" Text="Radeon Super Resolution" FontWeight="SemiBold" FontSize="15"
                                                    TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                <Border Style="{StaticResource ValueBadgeStyle}" Margin="8,0,0,0"
                                                        Visibility="{Binding ElementName=AMDRadeonSuperResolutionToggle, Path=IsOn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding ElementName=AMDRadeonSuperResolutionSharpnessSlider, Path=Value, Converter={StaticResource SharpnessPercentStringConverter}}" Style="{StaticResource ValueBadgeTextStyle}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Spatial upscaling with sharpening filter" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="AMDRadeonSuperResolutionToggle" IsEnabled="False" OffContent="Disabled" OnContent="Enabled"
                                            VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="AMDRadeonSuperResolutionSharpnessSlider"
                                        Minimum="0" Maximum="100"
                                        TickFrequency="1"
                                        SnapsTo="Ticks"
                                        TickPlacement="BottomRight"
                                        IsEnabled="False"
                                        Margin="0,6,0,0"
                                        Visibility="{Binding ElementName=AMDRadeonSuperResolutionToggle, Path=IsOn, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,10,0,10"/>

                                    <!-- AFMF with Value Badge -->
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="AMDFluidMotionFrameText" Text="AMD Fluid Motion Frame" FontWeight="SemiBold" FontSize="15"
                                                    TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <Border Style="{StaticResource ValueBadgeStyle}" Margin="8,0,0,0"
                                                        Visibility="{Binding ElementName=AMDFluidMotionFrameToggle, Path=IsOn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="ON" Style="{StaticResource ValueBadgeTextStyle}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Optical flow driver-level frame generation" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="AMDFluidMotionFrameToggle" IsEnabled="False" OffContent="Disabled" OnContent="Enabled"
                                            VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECTION: LATENCY & DYNAMICS -->
                            <TextBlock Text="LATENCY &amp; DYNAMICS" Style="{StaticResource SectionHeaderTextStyle}"/>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Border.Resources>
                                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#ED1C24"/>
                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#D01820"/>
                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#B8141C"/>
                                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#ED1C24"/>
                                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#D01820"/>
                                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#B8141C"/>
                                </Border.Resources>
                                <StackPanel>
                                    <!-- Anti-Lag with Value Badge -->
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="AMDRadeonAntiLagText" Text="Radeon Anti-Lag" FontWeight="SemiBold" FontSize="15"
                                                    TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <Border Style="{StaticResource ValueBadgeStyle}" Margin="8,0,0,0"
                                                        Visibility="{Binding ElementName=AMDRadeonAntiLagToggle, Path=IsOn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="ON" Style="{StaticResource ValueBadgeTextStyle}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Paces CPU work to minimize input latency" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="AMDRadeonAntiLagToggle" IsEnabled="False" OffContent="Disabled" OnContent="Enabled"
                                            VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,10,0,10"/>

                                    <!-- Boost with Value Badge -->
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="AMDRadeonBoostText" Text="Radeon Boost" FontWeight="SemiBold" FontSize="15"
                                                    TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <Border Style="{StaticResource ValueBadgeStyle}" Margin="8,0,0,0"
                                                        Visibility="{Binding ElementName=AMDRadeonBoostToggle, Path=IsOn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding ElementName=AMDRadeonBoostResolutionSlider, Path=Value, Converter={StaticResource RadeonBoostResolutionStringConverter}}" Style="{StaticResource ValueBadgeTextStyle}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Dynamic resolution during fast camera motion" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="AMDRadeonBoostToggle" IsEnabled="False" OffContent="Disabled" OnContent="Enabled"
                                            VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="AMDRadeonBoostResolutionSlider"
                                        Minimum="0" Maximum="1"
                                        TickFrequency="1"
                                        SnapsTo="Ticks"
                                        TickPlacement="BottomRight"
                                        IsEnabled="False"
                                        Margin="0,6,0,0"
                                        Visibility="{Binding ElementName=AMDRadeonBoostToggle, Path=IsOn, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>

                            <!-- SECTION: RADEON CHILL -->
                            <TextBlock Text="RADEON CHILL" Style="{StaticResource SectionHeaderTextStyle}"/>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Border.Resources>
                                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#ED1C24"/>
                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#D01820"/>
                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#B8141C"/>
                                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#ED1C24"/>
                                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#D01820"/>
                                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#B8141C"/>
                                </Border.Resources>
                                <StackPanel>
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock x:Name="AMDRadeonChillText" Text="Radeon Chill" FontWeight="SemiBold" FontSize="15"
                                                TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            <TextBlock Text="Power-saving dynamic FPS regulation" Style="{StaticResource SubtitleTextStyle}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="AMDRadeonChillToggle" IsEnabled="False" OffContent="Disabled" OnContent="Enabled"
                                            VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                    
                                    <StackPanel Visibility="{Binding ElementName=AMDRadeonChillToggle, Path=IsOn, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,0,0">
                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,4,0,8"/>
                                        
                                        <TextBlock x:Name="AMDRadeonChillMinFPSText" Text="{Binding ElementName=AMDRadeonChillMinFPSSlider, Path=Value, Converter={StaticResource RadeonChillMinFPSStringConverter}}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                                        <Slider x:Name="AMDRadeonChillMinFPSSlider"
                                            Minimum="30" Maximum="300"
                                            TickFrequency="5"
                                            SnapsTo="Ticks"
                                            TickPlacement="BottomRight"
                                            IsEnabled="False"/>
                                            
                                        <TextBlock x:Name="AMDRadeonChillMaxFPSText" Text="{Binding ElementName=AMDRadeonChillMaxFPSSlider, Path=Value, Converter={StaticResource RadeonChillMaxFPSStringConverter}}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        <Slider x:Name="AMDRadeonChillMaxFPSSlider"
                                            Minimum="30" Maximum="300"
                                            TickFrequency="5"
                                            SnapsTo="Ticks"
                                            TickPlacement="BottomRight"
                                            IsEnabled="False"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>

                <!-- NVIDIA SETTINGS TAB (GeForce Green Themed) -->
                <PivotItem x:Name="NvidiaPivotItem">
                    <PivotItem.Header>
                        <StackPanel x:Name="NvidiaPivotItemStackPanel" Orientation="Horizontal" Margin="6,0,24,0">
                            <FontIcon Glyph="&#xE9D9;" Margin="0,0,8,0" FontSize="15" VerticalAlignment="Center" Foreground="{StaticResource GeForceGreenBrush}"/>
                            <TextBlock Text="NVIDIA" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </PivotItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" XYFocusKeyboardNavigation="Enabled">
                        <StackPanel Margin="0,2,0,16">

                            <!-- SECTION: NVIDIA APP -->
                            <TextBlock Text="NVIDIA SOFTWARE" Style="{StaticResource SectionHeaderTextStyle}"/>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid Margin="0,2,0,2">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock x:Name="NvidiaAppText" Text="NVIDIA App" FontWeight="SemiBold" FontSize="15"
                                            TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        <TextBlock Text="Open NVIDIA App / GeForce Experience overlay" Style="{StaticResource SubtitleTextStyle}"/>
                                    </StackPanel>
                                    <Button x:Name="LaunchNvidiaAppButton" Content="Open" Width="140" HorizontalAlignment="Right" Click="LaunchNvidiaAppButton_Click"
                                        Background="#76B900" Foreground="Black" FontWeight="Bold" CornerRadius="6"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
            </Pivot>

            <!-- Thin line below the tabs -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="0,0,0,1" 
                    VerticalAlignment="Top" 
                    Margin="0,0,0,0"
                    Height="48" 
                    IsHitTestVisible="False"/>
        </Grid>
    </Grid>

</Page>
